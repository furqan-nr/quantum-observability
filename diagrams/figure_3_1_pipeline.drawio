<mxfile host="app.diagrams.net" type="device">
  <diagram name="Figure 3.1 - cart pipeline" id="Figure_3.1_-_cart_pipeline">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="320" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s0" value="&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;1.  Manifest &amp;amp; Instrument&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;Builds a static manifest and&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;instruments transpilation, so&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;pass stages are observed.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;2.  Events &amp;amp; Cohorts&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;Constructs change-events,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;assigns non-pooled cohorts,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;and a mutation engine.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="267.5" y="30" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;3.  Tiered Oracles&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;Applies width-tiered oracles&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;to produce write-once&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;ground-truth labels.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="515.0" y="30" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;4.  Selection &amp;amp; Baselines&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;Runs the transparent&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;risk_score selector against&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;five baselines under a budget.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="762.5" y="30" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;5.  Metrics &amp;amp; Gates&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;Computes the metric suite&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;and enforces six validity&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;gates before any result.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1010.0" y="30" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="sub" value="&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Shared reproducibility substrate&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;two-layer execution environment  ·  write-once artifacts  ·  CPU-time cost calibration&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;frozen change-stage map  ·  group-level temporal split  ·  strict claim-scope rule&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="1200" height="80" as="geometry"/></mxCell>
