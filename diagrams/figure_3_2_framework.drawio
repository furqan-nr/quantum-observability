  <diagram name="Figure 3.2 - research framework" id="Figure_3.2_-_research_framework">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="prob" value="&lt;font color=&quot;#2A5A9E&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;ONE PROBLEM&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:11.5px&quot;&gt;Regression-test the Qiskit transpiler — effectively and within budget&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="290" y="20" width="420" height="66" as="geometry"/></mxCell>
        <mxCell id="eff" value="&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;EFFECTIVENESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:11px&quot;&gt;Observability-aware fault detection&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;RQ1  prevalence of the gap&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;RQ2  gap is real and closable&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:11px&quot;&gt;Method: mine merged transpiler fixes,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:11px&quot;&gt;fault-class-matched (contract / isolated-pass) oracles&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Feasibility: demonstrated&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="390" height="228" as="geometry"/></mxCell>
        <mxCell id="cost" value="&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;COST&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:11px&quot;&gt;Budgeted, cost-aware test selection&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B36B00&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;RQ4  selector vs. baselines&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:11px&quot;&gt;(including random ordering)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:11px&quot;&gt;Method: transparent risk_score,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:11px&quot;&gt;leakage-safe temporal evaluation&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B36B00&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Scale-up: powered comparison&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="550" y="150" width="390" height="228" as="geometry"/></mxCell>
        <mxCell id="found" value="&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;FOUNDATION — Leakage-safe validity (RQ3)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B475C&quot; style=&quot;font-size:10.5px&quot;&gt;cohort separation · provenance control · six executable validity gates · operational soundness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="140" y="418" width="720" height="70" as="geometry"/></mxCell>
        <mxCell id="conc" value="&lt;font color=&quot;#2A5A9E&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;CONCLUSION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:11px&quot;&gt;The observability gap is real, common, and closable, and the&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1A2A3A&quot; style=&quot;font-size:11px&quot;&gt;methodology is realisable and evaluated honestly.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="260" y="524" width="480" height="68" as="geometry"/></mxCell>
